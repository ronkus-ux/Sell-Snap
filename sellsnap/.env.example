# Database connection
# DATABASE_URL = the pooled/Transaction connection (Supabase port 6543 + ?pgbouncer=true)
# DIRECT_URL   = the Direct connection (Supabase port 5432) — used for migrations
DATABASE_URL="postgresql://postgres:password@host:6543/sellsnap?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@host:5432/sellsnap?schema=public"

# Auth
NEXTAUTH_SECRET="change-this-to-a-random-32-char-secret"
NEXTAUTH_URL="http://localhost:3000"

# Flutterwave
FLW_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxx-X"
FLW_PUBLIC_KEY="FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx-X"
FLW_SECRET_HASH="sellsnap_secret_webhook_hash"

# Email
RESEND_API_KEY="re_123456789"

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_123456789"

# App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
